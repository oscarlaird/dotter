{
  "version": "0.2.0",
  "configurations": [
    
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug trie_exploratory_trace",
      "cargo": {
        "args": [
          "test",
          "--manifest-path",
          "${workspaceFolder}/bayesian/Cargo.toml",
          "--lib",
          "--no-default-features",
          "--features",
          "tokentrie",
          "--no-run"
        ],
        "filter": {
          "name": "bayesian"
        }
      },
      "args": [
        "trie_exploratory_trace",
        "--nocapture"
      ],
      "cwd": "${workspaceFolder}/bayesian",
      "sourceLanguages": ["rust"],
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "initCommands": [
        "settings set target.max-children-count 32",
        "settings set target.max-string-summary-length 10",
        "settings set target.max-children-depth 3"
      ]
    }
  ]
}
